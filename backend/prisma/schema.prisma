// Prisma schema for EthAum v2.
// Read docs/DATABASE.md and AGENTS.md before making changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model IntakePreview {
  id        String   @id @default(uuid())
  procedure String   @db.VarChar(120)
  country   String   @db.VarChar(80)
  timeline  String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("intake_previews")
}
